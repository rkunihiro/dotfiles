{
    "typescript": {
        "lineWidth": 120,
        "indentWidth": 4,
        "module.sortImportDeclarations": "maintain",
        "module.sortExportDeclarations": "maintain",
        "exportDeclaration.sortNamedExports": "maintain",
        "importDeclaration.sortNamedImports": "maintain"
    },
    "json": {
        "lineWidth": 120,
        "indentWidth": 4
    },
    "markdown": {
        "lineWidth": 120
    },
    "toml": {
        "lineWidth": 120,
        "indentWidth": 2
    },
    "dockerfile": {
        "lineWidth": 120
    },
    "malva": {
        "indentWidth": 4
    },
    "markup": {
        "printWidth": 120,
        "indentWidth": 4
    },
    "yaml": {
        "printWidth": 120,
        "indentWidth": 2
    },
    "excludes": [
        "**/node_modules",
        "**/*-lock.json"
    ],
    "plugins": [
        "npm:@dprint/typescript@0.101.0",
        "npm:@dprint/json@0.26.0",
        "npm:@dprint/markdown@0.29.0",
        "npm:@dprint/toml@0.10.0",
        "npm:@dprint/dockerfile@0.8.0",
        "npm:dprint-plugin-malva@0.16.1",
        "npm:dprint-plugin-markup@0.28.0",
        "npm:dprint-plugin-yaml@0.6.0"
    ]
}
